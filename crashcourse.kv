<DossierRoot>:
    orientation: 'vertical'
    padding: 20
    spacing: 10

    Label:
        id: mon_label
        text: 'Bienvenue dans le Crash Course Kivy de tiavina  !'
        font_size: 24

    Button:
        text: 'Cliquez-moi'
        background_color: 0.2, 0.6, 0.8, 1
        on_press: root.press_bouton()