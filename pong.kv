#:kivy 2.2.0

<PongBall>:
    size: 50, 50
    canvas:
        # loko mavomavo
        Color:
            rgb: 1.0, 0.9, 0.0
        Ellipse:
            pos: self.pos
            size: self.size

<PongPaddle>:
    size: 25, 200
    canvas:
        # Rectangle de base 
        Rectangle:
            pos: self.pos
            size: self.size

<PongGame>:
    ball: pong_ball
    player1: player_left
    player2: player_right

    canvas:
        # Fond mainty
        Color:
            rgb: 0.05, 0.05, 0.05
        Rectangle:
            pos: 0, 0
            size: self.size

        # Ligne centrale en rouge
        Color:
            rgb: 0.9, 0.1, 0.1
        Rectangle:
            pos: self.center_x - 5, 0
            size: 10, self.height

    Label:
        font_size: 70
        center_x: root.width / 4
        top: root.top - 50
        text: str(root.player1.score)
        color: 0.1, 0.8, 0.2, 1  # Score joueur 1 en vert

    Label:
        font_size: 70
        center_x: root.width * 3 / 4
        top: root.top - 50
        text: str(root.player2.score)
        color: 0.9, 0.1, 0.1, 1  # Score joueur 2 en rouge

    PongBall:
        id: pong_ball
        center: self.center

    PongPaddle:
        id: player_left
        x: root.x
        center_y: root.center_y
        canvas:
            # Raquette Gauche en Vert ( maintso)
            Color:
                rgb: 0.1, 0.8, 0.2
            Rectangle:
                pos: self.pos
                size: self.size

    PongPaddle:
        id: player_right
        x: root.width - self.width
        center_y: root.center_y
        canvas:
            # Raquette Droite en Rouge ( mena)
            Color:
                rgb: 0.9, 0.1, 0.1
            Rectangle:
                pos: self.pos
                size: self.size